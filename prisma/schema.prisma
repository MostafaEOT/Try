generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id            String     @id
  name          String
  icon          String
  description   String
  color         String
  bgColor       String
  count         Int        @default(0)
  subcategories String[]
  providers     Provider[]
}

model Provider {
  id             String          @id
  name           String
  avatar         String
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id])
  subcategory    String
  rating         Float
  reviewCount    Int             @default(0)
  hourlyRate     Int
  bio            String
  location       String
  experience     Int
  completedJobs  Int             @default(0)
  responseTime   String
  verified       Boolean         @default(false)
  badges         String[]
  availability   String[]
  portfolio      String[]
  online         Boolean         @default(false)
  distanceKm     Float           @default(0)
  acceptanceRate Int             @default(0)
  bankAccount    String?
  userId         String?  @unique
  user           User?    @relation("ProviderUser", fields: [userId], references: [id])
  reviews        Review[]
  bookings       Booking[]
  favorites      Favorite[]
  payoutRequests PayoutRequest[]
}

model Review {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])
  customerId String?
  author     String
  avatar     String
  rating     Int
  comment    String
  date       String
  service    String
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String
  role          String
  avatar        String
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  bookings        Booking[]
  favorites       Favorite[]
  notifications   Notification[]
  disputes        Dispute[]
  sentMessages           Message[]        @relation("MessageSender")
  providerProfile        Provider?        @relation("ProviderUser")
  shopProfile            Shop?            @relation("ShopUser")
  workerMaterialRequests MaterialRequest[] @relation("WorkerMaterialRequests")
}

model Booking {
  id         String    @id @default(cuid())
  customerId String
  customer   User      @relation(fields: [customerId], references: [id])
  providerId String
  provider   Provider  @relation(fields: [providerId], references: [id])
  service    String
  date       String
  time       String
  status     String    @default("pending")
  price            Float
  materialsTotal   Float             @default(0)
  address          String
  notes      String?
  jobPhotos  String[]  @default([])
  reviewed   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  dispute          Dispute?
  messages         Message[]
  materialRequests MaterialRequest[]
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, providerId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  read      Boolean  @default(false)
  bookingId String?
  createdAt DateTime @default(now())
}

model Dispute {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  booking     Booking  @relation(fields: [bookingId], references: [id])
  customerId  String
  customer    User     @relation(fields: [customerId], references: [id])
  reason      String
  description String
  status      String   @default("open")
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  senderId  String
  sender    User     @relation("MessageSender", fields: [senderId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model PayoutRequest {
  id          String   @id @default(cuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id])
  amount      Float
  status      String   @default("pending")
  bankAccount String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Shop {
  id          String            @id @default(cuid())
  name        String
  avatar      String            @default("")
  description String            @default("")
  location    String            @default("")
  phone       String            @default("")
  specialties String[]
  online      Boolean           @default(true)
  userId      String            @unique
  user        User              @relation("ShopUser", fields: [userId], references: [id])
  products    Product[]
  orders      MaterialRequest[]
  createdAt   DateTime          @default(now())
}

model Product {
  id          String      @id @default(cuid())
  shopId      String
  shop        Shop        @relation(fields: [shopId], references: [id])
  name        String
  description String      @default("")
  price       Float
  unit        String      @default("unit")
  category    String      @default("")
  inStock     Boolean     @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
}

model MaterialRequest {
  id         String      @id @default(cuid())
  bookingId  String
  booking    Booking     @relation(fields: [bookingId], references: [id])
  shopId     String
  shop       Shop        @relation(fields: [shopId], references: [id])
  workerId   String
  worker     User        @relation("WorkerMaterialRequests", fields: [workerId], references: [id])
  status     String      @default("pending_approval")
  totalCost  Float       @default(0)
  notes      String      @default("")
  items      OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model OrderItem {
  id                String          @id @default(cuid())
  materialRequestId String
  materialRequest   MaterialRequest @relation(fields: [materialRequestId], references: [id])
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  quantity          Int
  unitPrice         Float
  createdAt         DateTime        @default(now())
}
